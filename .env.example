# Copy to .env (never commit it) or export these in your shell / hosting platform.
ZEFIX_USER=your-zefix-username
ZEFIX_PASSWORD=your-zefix-password

# OAuth (required on any public deployment)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://zefix-mcp-server
SERVER_URL=https://your-host.example.com/mcp

# Optional
HOST=127.0.0.1
PORT=8000
